// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

// Note that some adapters may set a maximum length for the String type by default, please ensure your strings are long
// enough when changing adapters.
// See https://www.prisma.io/docs/orm/reference/prisma-schema-reference#string for more information
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Session {
  id                  String    @id
  shop                String
  state               String
  isOnline            Boolean   @default(false)
  scope               String?
  expires             DateTime?
  accessToken         String
  userId              BigInt?
  firstName           String?
  lastName            String?
  email               String?
  accountOwner        Boolean   @default(false)
  locale              String?
  collaborator        Boolean?  @default(false)
  emailVerified       Boolean?  @default(false)
  refreshToken        String?
  refreshTokenExpires DateTime?
}

model MerchantSettings {
  id                       String            @id @default(uuid())
  shop                     String            @unique
  notificationEmail        String?
  slackWebhookUrl          String?
  slackWorkspaceName       String?
  slackChannelName         String?
  enabledNotificationTypes String[]          @default(["EMAIL", "SLACK", "IN_APP"])
  hasCompletedOnboarding   Boolean           @default(false)
  updatedAt                DateTime          @updatedAt
  createdAt                DateTime          @default(now())

  // Relations
  workflows                WorkflowSetting[]
  activityLogs             ActivityLog[]
  suggestions              Suggestion[]

  @@index([shop])
}

model WorkflowSetting {
  id              String           @id @default(uuid())
  shop            String
  recipeSlug      String
  isActive        Boolean          @default(false)
  flowWorkflowId  String?
  deliveryChannel String           @default("EMAIL")
  config          Json             @default("{}")
  lastRunAt       DateTime?
  lastAlertedAt   DateTime?
  lastFingerprint String?
  updatedAt       DateTime         @updatedAt
  createdAt       DateTime         @default(now())

  // Foreign key relation to MerchantSettings
  merchant        MerchantSettings @relation(fields: [shop], references: [shop], onDelete: Cascade)

  @@unique([shop, recipeSlug])
  @@index([shop])
}

model ActivityLog {
  id          String           @id @default(uuid())
  shop        String
  recipeSlug  String
  recipeName  String
  summaryText String
  channel     String           @default("IN_APP")
  status      String           @default("Completed")
  isRead      Boolean          @default(false)
  details     Json?            @default("{}")
  createdAt   DateTime         @default(now())

  // Foreign key relation to MerchantSettings
  merchant    MerchantSettings @relation(fields: [shop], references: [shop], onDelete: Cascade)

  @@index([shop, createdAt(sort: Desc)])
  @@index([shop, isRead])
}

model Suggestion {
  id           String           @id @default(uuid())
  shop         String
  name         String
  problem      String
  trigger      String
  contactEmail String?
  createdAt    DateTime         @default(now())

  // Foreign key relation to MerchantSettings
  merchant     MerchantSettings @relation(fields: [shop], references: [shop], onDelete: Cascade)

  @@index([shop, createdAt(sort: Desc)])
}
